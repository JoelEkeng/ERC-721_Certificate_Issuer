# =============================================================================
# On-Chain Certificate Issuer — Environment Variables
# =============================================================================
# Copy this file to .env (backend) and apps/web/.env.local (frontend).
# NEVER commit actual secrets to source control.
# =============================================================================

# --- Blockchain RPC ---
# Local Anvil default. Replace with Alchemy/Infura URL for testnets.
RPC_URL=http://127.0.0.1:8545

# --- Contract ---
# Deployed CertificateIssuer address (update after deployment).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Chain ---
CHAIN_ID=31337

# --- Frontend (prefixed with NEXT_PUBLIC_ for Next.js client access) ---
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# --- Deployment (Foundry script) ---
# Safety guard: deployment script aborts if chain ID doesn't match.
# Set to 31337 for Anvil, 11155111 for Sepolia, etc.
EXPECTED_CHAIN_ID=31337

# ERC-721 collection name and symbol (optional, defaults shown).
CERTIFICATE_NAME=On-Chain Certificate
CERTIFICATE_SYMBOL=CERT

# Etherscan API key for contract verification (optional).
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
