# =============================================================================
# On-Chain Certificate Issuer — Environment Variables
# =============================================================================
# Copy this file to .env (backend) and apps/web/.env.local (frontend).
# NEVER commit actual secrets to source control.
# =============================================================================

# --- Blockchain RPC ---
# Local Anvil default. Replace with Alchemy/Infura URL for testnets.
RPC_URL=http://127.0.0.1:8545

# --- Contract ---
# Deployed CertificateIssuer address (update after deployment).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Chain ---
CHAIN_ID=31337

# --- Frontend (prefixed with NEXT_PUBLIC_ for Next.js client access) ---
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# --- Deployment (Foundry script) ---
# Safety guard: deployment script aborts if chain ID doesn't match.
# Set to 31337 for Anvil, 11155111 for Sepolia, etc.
EXPECTED_CHAIN_ID=31337

# ERC-721 collection name and symbol (optional, defaults shown).
CERTIFICATE_NAME=On-Chain Certificate
CERTIFICATE_SYMBOL=CERT

# Etherscan API key for contract verification (optional).
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# SQLite for local dev. For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/certificates
DATABASE_URL=sqlite+aiosqlite:///./certificates.db

# --- Event Indexer ---
INDEXER_POLL_INTERVAL=5
INDEXER_BLOCK_BATCH_SIZE=2000
# Confirmation depth: 0 for Anvil, 1 for testnets, >=12 for mainnet
INDEXER_CONFIRMATION_DEPTH=1
INDEXER_MAX_RETRIES=5
INDEXER_BACKOFF_BASE=1.5

# --- SIWE Authentication ---
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_NONCE_TTL=300

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
# Storage backend for rate limiting. Default: in-memory (per-process).
# For multi-worker deployments, use Redis: redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# --- Session Tokens ---
# HMAC signing key for session tokens (base64-encoded, >= 32 bytes).
# If empty, a random key is generated per-startup (sessions lost on restart).
# Generate: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# SESSION_SECRET=

# --- Debug ---
# Set to true for verbose error responses. NEVER true in production.
DEBUG=false
